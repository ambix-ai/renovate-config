{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "labels": [
    "dependencies"
  ],
  "automergeStrategy": "squash",
  "automergeType": "pr",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.ya?ml$/"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge low-risk infra updates (minor/patch/digest)",
      "matchManagers": [
        "dockerfile",
        "kubernetes",
        "github-actions",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge major GitHub Actions bumps — review them",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Group non-major Go module updates into one PR",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go modules (non-major)"
    }
  ]
}
